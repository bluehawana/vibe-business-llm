# Anthropic — leave unset if you are logged in via `ant auth login`
# ANTHROPIC_API_KEY=sk-ant-...

# Model powering the builder (default: claude-fable-5, falls back to claude-opus-4-8)
# VIBE_MODEL=claude-fable-5

# Staff screens (kitchen, reception, pay, panel, admin) require this password.
# Left unset, those screens refuse to serve at all — they fail closed rather than
# sit open behind a public URL. run.sh generates one on first start.
# VIBE_STAFF_PASSWORD=

# Payments are MANDATORY — a shop cannot accept orders without prepayment.
# Provide Stripe keys for real prepayment (test or live):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Two endpoints (test + live, or mid-rotation)? Comma-separate them — an event
# is accepted if ANY of these signed it:
# STRIPE_WEBHOOK_SECRET=whsec_test_one,whsec_live_two
#
# OR, for local development only, enable the no-Stripe stub that simulates a
# successful payment so you can exercise the full order chain without keys:
# VIBE_DEMO_PAYMENTS=1

# Single-restaurant install: serve this project at "/" so the QR code and the
# Instagram bio can just say order.ichiban.biz. Leave empty for the platform page.
# VIBE_HOME_PROJECT=db3c418e95a6

# Public base URL (used for Stripe redirect URLs)
# BASE_URL=http://localhost:8100

# Off-site backups to Cloudflare R2 (S3-compatible). Without these the hourly
# backup still runs locally — it just stays on the same disk as the database.
# Create: Cloudflare > R2 > Create bucket, then R2 > Manage API tokens
# > Create token with Object Read & Write on that bucket.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=ichiban-backups
