# Anthropic — leave unset if you are logged in via `ant auth login`
# ANTHROPIC_API_KEY=sk-ant-...

# Model powering the builder (default: claude-fable-5, falls back to claude-opus-4-8)
# VIBE_MODEL=claude-fable-5

# Staff screens (kitchen, reception, pay, panel, admin) require this password.
# Left unset, those screens refuse to serve at all — they fail closed rather than
# sit open behind a public URL. run.sh generates one on first start.
# VIBE_STAFF_PASSWORD=

# Payments are MANDATORY — a shop cannot accept orders without prepayment.
# Provide Stripe keys for real prepayment (test or live):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# OR, for local development only, enable the no-Stripe stub that simulates a
# successful payment so you can exercise the full order chain without keys:
# VIBE_DEMO_PAYMENTS=1

# Public base URL (used for Stripe redirect URLs)
# BASE_URL=http://localhost:8100
